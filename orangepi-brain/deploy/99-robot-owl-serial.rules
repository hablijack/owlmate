# Grant the robotowl user read/write access to the ESP32-S3 USB CDC serial
# port without needing root. The XIAO ESP32-S3 enumerates as a USB CDC ACM
# device (usb_id 303a:1001). Install into /etc/udev/rules.d/ via install.sh.
#
# Restrict access to the Espressif device, not every unrelated ACM peripheral.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0660", GROUP="dialout", SYMLINK+="robot-owl"
